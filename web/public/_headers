# cloudflare pages reads this file. next puts a content hash in every filename
# under _next/static, so those can be cached forever. everything else (the html
# and data/jobs.json) keeps pages' default of revalidating every time, otherwise
# people would keep seeing an old list after a refresh.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# static export writes the link preview images with no file extension, and
# cloudflare picks the content type from the extension. without this they go out
# as a generic download, and discord/linkedin/imessage skip them and show no image.
/opengraph-image
  Content-Type: image/png
/*/opengraph-image
  Content-Type: image/png
